# Python caches/build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments and local config
.venv/
venv/
.env
.envrc
.claude/settings.local.json

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Research outputs and large/generated arrays
# (figures are committed as versioned report assets; data/runs stay regenerable-only)
outputs/data/*.npz
outputs/runs/*
*.npy
*.npz
*.zarr/
*.pt
*.ckpt

# Keep documentation/placeholders in ignored output directories
!outputs/**/README.md
!outputs/**/.gitkeep

# OS/editor noise
.DS_Store
*.swp
~*
